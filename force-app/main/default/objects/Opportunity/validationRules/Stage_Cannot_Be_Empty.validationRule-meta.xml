<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Stage_Cannot_Be_Empty</fullName>
    <active>true</active>
    <description>Prevents an Opportunity from being saved without a Stage value.</description>
    <errorConditionFormula>ISBLANK(TEXT(StageName))</errorConditionFormula>
    <errorDisplayField>StageName</errorDisplayField>
    <errorMessage>Stage is required.</errorMessage>
</ValidationRule>
